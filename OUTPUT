"""
Test suite for drone tracking system components.
"""
import unittest
import numpy as np
import cv2
from unittest.mock import MagicMock, patch

from drone_tracker.src.detector import ObjectDetector
from drone_tracker.src.tracker import ObjectTracker
from drone_tracker.src.controller import AirSimController

class TestObjectDetector(unittest.TestCase):
    def setUp(self):
        """Set up test detector."""
        self.config = {
            "target_color": (60, 255, 255),  # Green in HSV
            "color_tolerance": 20,
            "min_object_size": 100,
            "max_object_size": 10000
        }
        self.detector = ObjectDetector(self.config)
        
    def test_color_detection(self):
        """Test color-based object detection."""
        # Create test image with green rectangle
        img = np.zeros((480, 640, 3), dtype=np.uint8)
        cv2.rectangle(img, (100,100), (200,200), (0,255,0), -1)
        
        # Detect object
        bbox = self.detector.detect_color(img)
        
        # Verify detection
        self.assertIsNotNone(bbox)
        x, y, w, h = bbox
        self.assertTrue(90 <= x <= 110)
        self.assertTrue(90 <= y <= 110)
        self.assertTrue(90 <= w <= 110)
        self.assertTrue(90 <= h <= 110)

class TestObjectTracker(unittest.TestCase):
    def setUp(self):
        """Set up test tracker with mocked components."""
        self.tracker = ObjectTracker((60, 255, 255))
        self.tracker.controller = MagicMock()
        self.tracker.camera = MagicMock()
        
    def test_tracking_update(self):
        """Test tracking update loop."""
        # Mock camera frame with target
        test_frame = np.zeros((480, 640, 3), dtype=np.uint8)
        cv2.rectangle(test_frame, (320,240), (370,290), (0,255,0), -1)
        self.tracker.camera.capture_frame.return_value = test_frame
        
        # Run update
        self.tracker.update()
        
        # Verify drone commands
        self.tracker.controller.move_by_velocity.assert_called()
        
    def test_no_target(self):
        """Test behavior when no target is visible."""
        # Mock empty frame
        test_frame = np.zeros((480, 640, 3), dtype=np.uint8)
        self.tracker.camera.capture_frame.return_value = test_frame
        
        # Run update
        self.tracker.update()
        
        # Verify drone stops
        self.tracker.controller.stop.assert_called()

if __name__ == '__main__':
    unittest.main()
